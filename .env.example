# Copy to .env (gitignored) and fill in. Real environment variables take precedence over .env.
# Offline mode (--offline / KOL_OFFLINE=1) needs no keys.

# MiniMax TTS / ASR gateway (Stage 6) and optional Stage-4 keyframes
MINIMAX_API_KEY=your-minimax-api-key
# MINIMAX_BASE_URL=https://aiapi.2tocom.space

# Stage 5 video: Comfy Colab Kit gateway (Pika H3 Flex on MiniMax H3, Colab L4).
# The gateway sits behind Cloudflare Access: the service-token headers are required.
COMFY_GATEWAY_URL=https://gate.dongmynghedaibai.com
COMFY_GATEWAY_TOKEN=your-comfy-gateway-token
CF_ACCESS_CLIENT_ID=your-cloudflare-access-client-id
CF_ACCESS_CLIENT_SECRET_FILE=/home/you/.config/ckit/cf_access_secret

# Flow2API image gateway (Stage 4 first frames, character sheets, dramaclaw shot builder)
FLOW2API_API_KEY=your-flow2api-key
# FLOW2API_BASE_URL=http://host:8000
# Stage 4 first-frame image provider: flow2api (default, holds the face anchor) or minimax (image-01,
# text-only). Only this provider is used; it is never switched on failure. Per run: --image-provider.
# KEYFRAME_IMAGE_PROVIDER=flow2api

# Optional: per-model unit costs for the pre-generation estimate (JSON string or path to a JSON file).
# Unknown models are reported as null. Keys: per_job / per_second (video), per_call (TTS).
# KOL_UNIT_COSTS={"currency": "USD", "Pika-H3-Flex-MiniMax-H3": {"per_job": 0.0}, "tts-1": {"per_call": 0.0}}
